DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions

# Generic OpenAI-compatible overrides. If these are set, they take precedence over
# DEEPSEEK_* aliases above.
ASTRO_GLOBAL_LLM_API_KEY=
ASTRO_GLOBAL_LLM_MODEL=
ASTRO_GLOBAL_LLM_BASE_URL=
ASTRO_GLOBAL_LLM_TIMEOUT_SECONDS=60
ASTRO_GLOBAL_LLM_TEMPERATURE=0.2

# Production/server guardrails. Values here are examples only; never commit real secrets.
ASTRO_GLOBAL_ENV=development
ASTRO_GLOBAL_SESSION_TOKEN=
ASTRO_GLOBAL_CORS_ORIGINS=http://127.0.0.1:5173
ASTRO_GLOBAL_RATE_LIMIT_ENABLED=false
ASTRO_GLOBAL_RATE_LIMIT_PER_MINUTE=60
ASTRO_GLOBAL_MAX_REQUEST_BYTES=65536
